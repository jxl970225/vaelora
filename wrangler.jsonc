{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaelora",
  "compatibility_date": "2026-09-19",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "vaelora"
    }
  ],
  "vars": {
    // 单文件上限 8MB。客户端会先压缩到 ~1600px，正常远低于此值。
    "MAX_UPLOAD_BYTES": "8388608",
    // 管理员账号。非敏感，所以放 vars 而不是 secret。
    "ADMIN_USER": "admin",
    // IP 只存加盐哈希，不落明文。上线前用 wrangler secret put 覆盖掉这个 dev 值。
    "IP_SALT": "dev-only-salt-change-in-production",
    // R2 自定义域名。留空 = 图片走 Worker 代理。生产填上可省下每次看图的 Worker 请求。
    "IMAGE_BASE_URL": ""
  }
}
