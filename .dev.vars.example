# 复制成 .dev.vars 后填入真实值（本文件是模板，会进仓库）
#
# ⚠️ 注意哪些变量**同时**需要配到生产环境：
#
#   ADMIN_USER      非敏感，放 wrangler.jsonc 的 vars（不在这个文件里配也行，
#                   但生产必须配 —— 只配在本地会导致线上读不到，登录永远 401）
#   IMAGE_BASE_URL  同上，放 wrangler.jsonc 的 vars
#
# 下面的这些是敏感值，本地放这里，生产用 wrangler secret put 或后台 Secret：

# 管理员密码的 sha256，用 `npm run hash-password -- 你的密码` 生成
ADMIN_PASSWORD_HASH=

# 签发登录会话 token 的密钥，随便一串长随机值
SESSION_SECRET=

# IP 加盐哈希用的盐。wrangler.jsonc 里有个 dev 值，生产必须用 secret 覆盖它。
IP_SALT=

# 可选：配了才能在删除图片时立即清理 CDN 缓存
# 不配则靠 TTL 过期（此时缓存头会自动降为 5 分钟）
# 需要 Zone.Cache Purge 权限的 API token
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
