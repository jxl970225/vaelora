{
  "name": "vaelora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "bash scripts/deploy.sh --check",
    "deploy:setup": "bash scripts/deploy.sh",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply vaelora --local",
    "db:migrate:remote": "wrangler d1 migrations apply vaelora --remote"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.86.0"
  }
}
